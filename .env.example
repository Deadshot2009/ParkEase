# ==========================================
# ParkEase Configuration Environment File
# ==========================================

# Server Port
PORT=5000

# Database
# If MongoDB is running locally or on Atlas, provide connection string.
# Otherwise, ParkEase runs automatically on its high-performance local document store.
MONGODB_URI=mongodb://127.0.0.1:27017/parkease

# JWT Authentication Secret
JWT_SECRET=parkease_jwt_super_secret_key_2026_production

# Payment Gateway (Razorpay / UPI sandbox keys)
RAZORPAY_KEY_ID=rzp_test_parkease_sandbox
RAZORPAY_KEY_SECRET=rzp_test_secret_key

# Frontend URLs
CLIENT_URL=http://localhost:3000
