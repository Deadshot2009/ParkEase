{
  "name": "parkease",
  "version": "1.0.0",
  "description": "ParkEase – Smart Parking Reservation & Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "cd backend && node src/app.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:user": "cd frontend && npm run dev:user",
    "dev:admin": "cd frontend && npm run dev:admin",
    "build": "cd frontend && npm install && npm run build && cd ../backend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "start": "node backend/src/app.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.1"
  },
  "keywords": [
    "parking",
    "smart-parking",
    "ev-charging",
    "qr-code",
    "booking-system",
    "react",
    "vite",
    "tailwindcss",
    "nodejs",
    "express",
    "socketio"
  ],
  "author": "Deadshot2009",
  "license": "MIT"
}
